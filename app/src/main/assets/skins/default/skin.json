    "btn-play": {
      "function": "music.toggle",
      "apkStatus": "existing",
      "apkRef": "MainActivity.onMusicToggle() (jika belum ada lagu: membuka pustaka musik)"
    },
    "btn-preset-prev": {
      "function": "preset.prev",
      "apkStatus": "wrap-existing",
      "apkRef": "currentPreset - 1 (batas 1; preset terkunci FREE -> openProUpgradeLink)"
    },
    "btn-preset-next": {
      "function": "preset.next",
      "apkStatus": "wrap-existing",
      "apkRef": "currentPreset + 1 (batas presetCount; preset terkunci FREE -> openProUpgradeLink)"
    },
    "btn-preset-menu": {
      "function": "preset.menu",
      "apkStatus": "new",
      "apkRef": "tombol KIT -> tampil/sembunyi panel preset ASLI APK (bukan dialog baru)"
    },
    "btn-load": {
      "function": "file.load",
      "apkStatus": "existing",
      "apkRef": "showLoadSourceChooser = true"
    },
    "btn-export": {
      "function": "file.export",
      "apkStatus": "existing",
      "apkRef": "showExportConfirmDialog = true"
    },
    "btn-settings": {
      "function": "padSettings.open",
      "apkStatus": "existing",
      "apkRef": "onOpenSettings -> showPadVolumeSettings = true"
    },
    "vol-knob": {
      "function": "volume.kendang",
      "apkStatus": "existing",
      "apkRef": "MainActivity.onKendangVolumeChange(v: Float)"
    },
    "slot-display": {
      "function": "display.preset",
      "template": [
        "KIT",
        "P{preset:000}"
      ],
      "apkStatus": "wrap-existing",
      "apkRef": "currentPreset (APK belum punya nama preset: baris 1 = 'KIT', baris 2 = 'Pnnn')"
    },
    "btn-music": {
      "function": "music.panel",
      "apkStatus": "existing",
      "apkRef": "tombol MIDI -> tampil/sembunyi panel volume & musik ASLI APK (bukan dialog baru)"
    },
    "btn-voice": {
      "function": "sound.set",
      "apkStatus": "existing",
      "apkRef": "tombol VOICE -> SET SUARA pad terakhir yang diketuk"
    },
    "btn-screenrec": {
      "function": "screenrecord.toggle",
      "apkStatus": "existing",
      "apkRef": "tombol TAP (bulat) -> rekam layar"
    },
    "btn-skin": {
      "function": "skin.pick",
      "apkStatus": "existing",
      "apkRef": "tombol EXIT -> pemilih skin"
    },
    "btn-rec": {
      "function": "record.toggle",
      "apkStatus": "existing",
      "apkRef": "tombol ENTER (merah muda) -> rekam audio"
    },
    "btn-theme": {
      "function": "theme.open",
      "apkStatus": "existing",
      "apkRef": "tombol SHIFT -> tema warna"
    },
    "btn-seek-back": {
      "function": "music.seekBack",
      "apkStatus": "existing",
      "apkRef": "tombol ◄ -> mundur 5 detik"
    },
    "btn-seek-fwd": {
      "function": "music.seekForward",
      "apkStatus": "existing",
      "apkRef": "tombol ► -> maju 5 detik"
    }
